# Sampler build output.
output/

# Session-scoped ephemera produced by per-session prompts.
# Curated project knowledge lives in the rest of .memory-bank/ and stays tracked.
.memory-bank/session/handoff-*.md
.memory-bank/session/deadline-handoff-*.md
.memory-bank/session/compaction-*.md
.memory-bank/session/role-record-migration-*.json

# Prompt log — local session ephemera, intentionally untracked.
.memory-bank/promptHistory.md

# Eval harness run workspace — local, regenerated per run, not a repo artifact.
.evalwork/

# Trigger-eval scratch. -WorkDir belongs outside the repository; this catches
# the runs where it was not, because skills/ is the published module payload.
skills/*/scripts/work/
